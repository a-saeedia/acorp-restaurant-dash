{
  "name": "acorp-restaurant-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persian-first (RTL) restaurant operations dashboard and cinematic Remotion video system for A-Corp Restaurant Intelligence.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "demo": "node scripts/serve-dist.mjs 4318",
    "deploy": "pnpm run build && node -e \"require('fs').rmSync('dist/audio',{recursive:true,force:true})\" && wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check",
    "audio": "node scripts/generate-audio.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "video": "remotion studio src/video/index.ts",
    "video:render": "remotion render src/video/index.ts ACorpCommercial out/acorp-commercial.mp4",
    "video:stills": "node scripts/render-stills.mjs",
    "video:dry": "remotion render src/video/index.ts ACorpCommercial out/acorp-commercial.mp4 --frames=0-2",
    "bundle:html": "node scripts/bundle-single-html.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.18.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
